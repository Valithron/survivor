[gd_resource type="Resource" script_class="WeaponDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://game/data/weapon_definition.gd" id="1_weapon"]
[ext_resource type="Script" path="res://game/data/weapon_rank_definition.gd" id="2_rank"]
[ext_resource type="PackedScene" path="res://game/weapons/auto_turret_runtime.tscn" id="3_runtime"]

[sub_resource type="Resource" id="Rank1"]
